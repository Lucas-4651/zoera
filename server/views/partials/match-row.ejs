<%
  /* Ligne de match — hiérarchie : SCORE > statut live > équipes > compétition/heure.
     Réutilisée sur l'accueil, le direct, le calendrier, les fiches club et joueur.

     MOBILE (< 768 px) — grille à colonnes FIXES :
       [ heure 40 ][ équipe dom ][ score 64 ][ équipe ext ][ favori 44 ]
     Les cellules d'équipe ont une largeur fixe (le nom est tronqué sur
     2 lignes) : les écussons, l'heure, le score et le favori retombent
     toujours au même x, d'une ligne à l'autre.

     DESKTOP (md:) — la ligne dense d'origine : meta à gauche (176 px),
     puis domicile / score / extérieur, puis le favori (34 px). */
  const ev = event;
  const live = !!ev.isLive;
  const hasScore = ev.homeScore !== null && ev.awayScore !== null && ev.homeScore !== undefined && ev.awayScore !== undefined;
  const showScore = hasScore || live;
  const scoreValue = showScore ? ((ev.homeScore || 0) + ' – ' + (ev.awayScore || 0)) : '';
  const compName = ev.leagueName || '';
  const kickoff = ev.date ? fmt.time(ev.date) : '';
  const hT = (ev.homeScoreHt !== null && ev.homeScoreHt !== undefined) ? ev.homeScoreHt : null;
  const aT = (ev.awayScoreHt !== null && ev.awayScoreHt !== undefined) ? ev.awayScoreHt : null;
  const et = ev.extraTime || null;
  const pen = ev.penaltyShootout || null;

  let subLine = '';
  if (pen) subLine = 'Séparations ' + pen.home + '–' + pen.away;
  else if (et) subLine = 'Prolongations ' + et.home + '–' + et.away;
  else if (live && ev.period) subLine = fmt.period(ev.period);
  else if (hT !== null && aT !== null) subLine = 'Mi-temps ' + hT + '–' + aT;

  /* Même information, en plus court : la colonne score ne fait que 64 px
     sur mobile. */
  const PERIOD_SHORT = {
    '1st_half': '1re MT', first_half: '1re MT', halftime: 'MT',
    '2nd_half': '2e MT', second_half: '2e MT', extra_time: 'Prol.', FT: 'Terminé',
  };
  let subShort = '';
  if (pen) subShort = 'TAB ' + pen.home + '–' + pen.away;
  else if (et) subShort = 'Prol. ' + et.home + '–' + et.away;
  else if (live && ev.period) subShort = PERIOD_SHORT[ev.period] || fmt.period(ev.period);
  else if (hT !== null && aT !== null) subShort = 'MT ' + hT + '–' + aT;

  /* Score à deux chiffres de chaque côté (« 10 – 10 ») : on le réduit pour
     qu'il tienne dans la colonne score sans toucher aux colonnes voisines. */
  const scoreTight = scoreValue.length > 5;
  /* Couleur du score : live > score > heure (l'heure est secondaire). */
  const scoreTone = live ? 'text-acid-300' : (showScore ? 'text-mist-50' : 'text-mist-200');
%>
<li class="ko-match group relative border-b border-line/80 bg-ink-900 transition-colors duration-200 last:border-b-0 hover:bg-ink-850"
    data-live-match
    data-event-id="<%= ev.id %>"
    data-league-id="<%= ev.leagueId %>"
    data-status="<%= ev.status %>"
    data-minute="<%= ev.minute === null || ev.minute === undefined ? '' : ev.minute %>"
    data-home-score="<%= ev.homeScore === null || ev.homeScore === undefined ? '' : ev.homeScore %>"
    data-away-score="<%= ev.awayScore === null || ev.awayScore === undefined ? '' : ev.awayScore %>">

  <a href="/match/<%= ev.id %>"
     class="ko-match__row grid grid-cols-[40px_minmax(0,1fr)_64px_minmax(0,1fr)_44px] grid-rows-[auto_auto] items-start gap-x-2 gap-y-2.5 px-3 py-3 md:grid-cols-[176px_minmax(0,1fr)_176px_minmax(0,1fr)_34px] md:grid-rows-[auto] md:items-center md:gap-x-4 md:px-4">

    <!-- Meta : statut + compétition (bandeau secondaire, pleine largeur
         des 4 premières colonnes ; colonne de gauche sur desktop). -->
    <div class="col-span-4 row-start-1 flex min-w-0 items-center justify-between gap-2 md:col-span-1 md:row-start-1 md:flex-col md:items-start md:justify-start md:gap-1">
      <div class="flex min-w-0 items-center gap-2">
        <%- include("status-badge", { status: ev.status, minute: ev.minute, period: ev.period }) %>
        <% if (kickoff && showScore) { %>
          <% /* L'heure n'est répétée que sur desktop : sur mobile elle occupe
               sa propre colonne (gouttière gauche), toujours au même x. */ %>
          <span class="ko-tabular hidden text-[12px] text-mist-500 md:inline"><%= kickoff %></span>
        <% } %>
      </div>
      <span class="flex min-w-0 items-center gap-1.5">
        <% if (ev.leagueId) { %>
          <span class="hidden shrink-0 sm:inline-flex"><%- include("logo", { id: ev.leagueId, name: compName, kind: 'league', size: 'xs' }) %></span>

        <% } %>
        <span class="truncate text-[11px] text-mist-500 md:max-w-full"><%= compName %></span>
      </span>
    </div>

    <!-- HEURE — colonne stable (mobile uniquement). -->
    <% if (kickoff) { %>
      <span class="ko-match__time ko-tabular col-start-1 row-start-2 flex h-8 items-center whitespace-nowrap font-display text-[14px] leading-none font-bold tracking-tight text-mist-300 md:hidden"><%= kickoff %></span>
    <% } %>

    <!-- Équipe domicile : l'écusson occupe la bande du haut, le nom celle du
         bas. Le nom se contraint à la largeur de la cellule (2 lignes max) :
         il ne déplace plus l'écusson. -->
    <div data-ko="home"
         class="ko-match__team col-start-2 row-start-2 flex min-w-0 flex-col-reverse items-center gap-1.5 md:col-start-2 md:row-start-1 md:flex-row md:justify-end md:gap-2">
      <span class="ko-match__name line-clamp-2 w-full break-words text-center text-[11px] leading-[1.15] font-medium text-mist-200 md:w-auto md:max-w-none md:truncate md:text-right md:text-[14px] md:text-mist-100"><%= ev.homeTeam %></span>
      <%- include("img", { id: ev.homeTeamId, name: ev.homeTeam, kind: 'team', size: 'md' }) %>
    </div>

    <!-- SCORE (élément le plus fort) — colonne stable : le score y vit, ou
         l'heure quand le match n'a pas encore de résultat. -->
    <div data-ko="score"
         class="ko-match__score col-start-3 row-start-2 flex min-w-0 flex-col items-center gap-1.5 md:col-start-3 md:row-start-1 md:px-0.5">
      <span data-live-score
            class="ko-match__score-val ko-tabular font-display leading-none font-bold tracking-tight <%= scoreTone %> <%= !showScore ? 'ko-match__score-val--pending' : '' %> <%= scoreTight ? 'ko-match__score-val--tight' : '' %>"><% if (showScore) { %><%= scoreValue %><% } else { %><span class="text-mist-400 md:hidden">–</span><span class="hidden md:inline"><%= kickoff %></span><% } %></span>
      <% if (subLine) { %>
        <span class="ko-match__sub ko-match__sub--short whitespace-nowrap text-[9px] leading-none font-medium tracking-[0.02em] text-mist-500 uppercase"><%= subShort %></span>
        <span class="ko-match__sub ko-match__sub--long whitespace-nowrap text-[9px] leading-none font-medium tracking-[0.04em] text-mist-500 uppercase md:text-[10px]"><%= subLine %></span>
      <% } %>
    </div>

    <!-- Équipe extérieur (miroir de l'équipe domicile). -->
    <div data-ko="away"
         class="ko-match__team col-start-4 row-start-2 flex min-w-0 flex-col items-center gap-1.5 md:col-start-4 md:row-start-1 md:flex-row md:justify-start md:gap-2">
      <%- include("img", { id: ev.awayTeamId, name: ev.awayTeam, kind: 'team', size: 'md' }) %>
      <span class="ko-match__name line-clamp-2 w-full break-words text-center text-[11px] leading-[1.15] font-medium text-mist-200 md:w-auto md:max-w-none md:truncate md:text-left md:text-[14px] md:text-mist-100"><%= ev.awayTeam %></span>
    </div>

    <!-- Favori (cible tactile 44 px sur mobile). -->
    <div class="col-start-5 row-start-1 row-span-2 flex items-center justify-end self-center md:col-start-5 md:row-start-1 md:row-span-1">
      <button type="button" data-fav="match:<%= ev.id %>" aria-pressed="false"
              aria-label="Ajouter ce match aux favoris"
              class="ko-focus grid h-11 w-11 place-items-center rounded-[9px] text-mist-500 transition-colors duration-200 hover:bg-ink-750 hover:text-acid-300 md:h-9 md:w-9">
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.6l2.6 5.5 5.9.8-4.3 4.2 1 6-5.2-2.9-5.2 2.9 1-6L3.5 9.9l5.9-.8z"/></svg>
      </button>
    </div>
  </a>
</li>
