<%
  /* État vide réutilisable : jamais de page blanche. */
  const emptyTitle = (typeof title !== 'undefined' && title) ? title : 'Aucune donnée';
  const emptyMessage = (typeof message !== 'undefined' && message) ? message : 'Les informations ne sont pas disponibles pour le moment.';
  const emptyIcon = (typeof icon !== 'undefined' && icon) ? icon : 'calendar';
  const paths = {
    calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M8 3.5v3M16 3.5v3"/>',
    radio: '<circle cx="12" cy="12" r="2.4"/><path d="M8.2 8.2a5.4 5.4 0 0 0 0 7.6"/><path d="M15.8 15.8a5.4 5.4 0 0 0 0-7.6"/>',
    search: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>',
    chart: '<path d="M4 20V4"/><path d="M4 20h16"/><path d="M8 17V11"/><path d="M12.5 17V7"/>',
    trophy: '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 5.5H5.5v1A3.5 3.5 0 0 0 9 10"/><path d="M16 5.5h2.5v1A3.5 3.5 0 0 1 15 10"/><path d="M12 13v4"/><path d="M8.5 20h7l-.7-3h-5.6z"/>',
    swap: '<path d="M4 8h13"/><path d="M14 5l3 3-3 3"/><path d="M20 16H7"/><path d="M10 13l-3 3 3 3"/>',
    sparkles: '<path d="M12 3.5 13.7 9l5.3 1.7-5.3 1.7L12 18l-1.7-5.6L5 10.7 10.3 9z"/>'
  };
%>
<div class="relative flex flex-col items-center gap-3 overflow-hidden border border-dashed border-line-strong bg-ink-850/60 px-6 py-10 text-center">
  <span aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-16 h-32 opacity-60"
        style="background-image:radial-gradient(60% 100% at 50% 100%,rgba(205,245,66,.08),transparent 70%);"></span>
  <span class="relative grid h-12 w-12 place-items-center rounded-full border border-line bg-ink-800 text-mist-400">
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%- paths[emptyIcon] || paths.calendar %></svg>
  </span>
  <p class="relative font-display text-[16px] font-bold tracking-tight text-mist-100"><%= emptyTitle %></p>
  <p class="relative max-w-sm text-[13px] leading-relaxed text-mist-400"><%= emptyMessage %></p>
</div>
