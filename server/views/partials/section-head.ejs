<%
  /* Titre de section — le titre est OPTIQUEMENT CENTRÉ sur la largeur du
     conteneur, même quand une meta est présente à droite : grille 3 colonnes
     (1fr / auto / 1fr). Sur mobile : titre centré, meta sous le titre.

     meta : fragment HTML optionnel (lien, compteur) aligné à droite sur
            desktop, centré sous le titre sur mobile.
     sub  : petit texte secondaire centré sous le titre. */
  const shTitle = (typeof title !== 'undefined' && title) ? title : '';
  const shMeta = (typeof meta !== 'undefined' && meta) ? meta : '';
  const shSub = (typeof sub !== 'undefined' && sub) ? sub : '';
%>
<div class="mb-3 grid grid-cols-1 items-center gap-x-3 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
  <div class="hidden md:block" aria-hidden="true"></div>

  <div class="min-w-0 px-1 text-center">
    <h2 class="font-display text-[19px] leading-tight font-bold tracking-tight text-balance text-mist-50 md:text-[22px]"><%= shTitle %></h2>
    <% if (shSub) { %>
      <p class="mt-0.5 text-[12px] leading-snug text-pretty text-mist-400"><%= shSub %></p>
    <% } %>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-2 text-[12px] text-mist-400 md:justify-end [&_a]:transition-colors [&_a]:duration-200 [&_a]:hover:text-acid-300 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-acid-400">
    <%- shMeta %>
  </div>
</div>
