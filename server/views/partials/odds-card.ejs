<%
  /* Carte « cotes » — version mobile (< md) d'une ligne de /odds.
     Elle consomme la ligne DÉJÀ préparée par odds.ejs (mêmes objets que le
     tableau desktop) : aucun appel API supplémentaire, aucun calcul refait.

     Hiérarchie : marché + bookmaker > cotes (chiffres display) > équipes.
     Les noms d'équipes ne sont jamais tronqués : ils occupent toute la largeur
     restante (2 lignes maximum). */
  const c = card;
  const cOutcomes = c.outcomes || [];
  /* 3 issues (1X2) ou 2 issues (plus/moins, les 2 marquent) : la grille
     s'adapte pour ne pas laisser de cellule vide. */
  const cCols = cOutcomes.length >= 3 ? 'grid-cols-3' : (cOutcomes.length === 2 ? 'grid-cols-2' : 'grid-cols-1');
%>
<li class="border border-line bg-ink-900 transition-colors duration-200 hover:border-line-strong">

  <!-- Tête : compétition (pastille) + date du match -->
  <div class="flex items-center justify-between gap-2 border-b border-line px-3 py-2">
    <span class="flex min-w-0 items-center gap-1.5">
      <% if (c.leagueId !== null) { %>
        <%- include("img", { id: c.leagueId, name: c.leagueName || '', kind: 'league', size: 'xs' }) %>
      <% } %>
      <span class="truncate text-[11px] tracking-wide text-mist-500 uppercase"><%= c.leagueName || 'Compétition' %></span>
    </span>
    <span class="ko-tabular shrink-0 text-[11px] text-mist-400"><%= fmt.date(c.row.date, { withTime: true }) %></span>
  </div>

  <!-- Équipes : écusson + nom complet (jamais tronqué) -->
  <a href="/match/<%= c.row.eventId %>"
     class="ko-focus group flex items-center gap-2.5 px-3 py-2.5 transition-colors duration-200 hover:bg-ink-850"
     aria-label="Fiche du match : <%= c.homeName %> contre <%= c.awayName %>">
    <span class="min-w-0 flex-1">
      <span class="flex items-center gap-2.5">
        <% if (c.homeId !== null) { %>
          <%- include("img", { id: c.homeId, name: c.homeName, kind: 'team', size: 'md' }) %>
        <% } %>
        <span class="line-clamp-2 min-w-0 flex-1 text-[14px] leading-[1.2] font-medium text-mist-100"><%= c.homeName %></span>
      </span>
      <span class="mt-2 flex items-center gap-2.5">
        <% if (c.awayId !== null) { %>
          <%- include("img", { id: c.awayId, name: c.awayName, kind: 'team', size: 'md' }) %>
        <% } %>
        <span class="line-clamp-2 min-w-0 flex-1 text-[14px] leading-[1.2] font-medium text-mist-100"><%= c.awayName %></span>
      </span>
    </span>
    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-mist-500 transition-colors duration-200 group-hover:text-acid-300" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
  </a>

  <!-- Marchés et cotes : lignes empilées, lisibles sans défilement horizontal -->
  <div class="border-t border-line px-3 py-2.5">
    <div class="flex items-baseline justify-between gap-2">
      <span class="ko-eyebrow text-[11px] text-mist-200" title="<%= c.marketFull %>"><%= c.marketShort %></span>
      <span class="shrink-0 text-[10px] text-mist-400"><%= c.bookmakerText %></span>
    </div>

    <ul class="mt-2 grid gap-1.5 <%= cCols %>" aria-label="Cotes — <%= c.marketFull %>">
      <% cOutcomes.forEach(function (o) { %>
        <li class="rounded-[10px] bg-ink-850 px-2 py-1.5 text-center">
          <span class="block text-[9px] leading-none font-semibold tracking-[0.12em] text-mist-500 uppercase"><%= o.short %></span>
          <span class="mt-1 flex items-baseline justify-center gap-1">
            <span class="ko-tabular font-display text-[19px] leading-none font-bold text-mist-50"><%= o.decimal === null ? '—' : o.decimal.toFixed(2) %></span>
            <% if (o.movement === 'up') { %>
              <span class="font-sans text-[9px] leading-none text-acid-300" role="img" aria-label="cote en hausse">▲</span>
            <% } else if (o.movement === 'down') { %>
              <span class="font-sans text-[9px] leading-none text-blood-400" role="img" aria-label="cote en baisse">▼</span>
            <% } %>
          </span>
          <span class="ko-tabular mt-1 block text-[10px] leading-none text-mist-500"><%= fmt.percent(o.implied) %></span>
        </li>
      <% }); %>
    </ul>
  </div>
</li>
