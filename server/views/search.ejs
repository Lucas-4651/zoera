<%
  const teamResults = teams || [];
  const playerResults = players || [];
  const leagueResults = leagues || [];
  const q = query || '';
  const total = teamResults.length + playerResults.length + leagueResults.length;
%>

<%- include("partials/page-head", {
  eyebrow: 'Recherche',
  title: q ? 'Résultats pour « ' + q + ' »' : 'Recherche',
  subtitle: 'Équipes, joueurs et compétitions — tapez, les résultats s’affichent au fil de la frappe.'
}) %>

<form action="/recherche" method="get" role="search" class="mb-6">
  <label class="relative block">
    <span class="sr-only">Rechercher</span>
    <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-mist-400" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
    <input type="search" name="q" value="<%= q %>" data-search-input autocomplete="off"
           placeholder="Équipe, joueur ou ligue…"
           class="h-12 w-full rounded-[12px] border border-line bg-ink-850 pl-11 pr-4 text-[15px] text-mist-100 placeholder:text-mist-500 transition-colors duration-200 hover:border-line-strong focus:border-acid-500 focus:outline-none">
  </label>
</form>

<% if (q) { %>
  <div class="mb-6 flex justify-center">
    <span class="inline-flex max-w-full items-center gap-2 rounded-pill border border-acid-500/40 bg-acid-500/10 px-3.5 py-1.5">
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 text-acid-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      <span class="truncate font-display text-[14px] font-bold text-acid-300">« <%= q %> »</span>
      <span class="shrink-0 text-[11px] text-mist-500"><%= total %> <%= total > 1 ? 'résultats' : 'résultat' %></span>
    </span>
  </div>
<% } %>

<div data-search-results aria-live="polite">
  <% if (total === 0) { %>
    <%- include("partials/empty-state", {
      title: q ? 'Aucun résultat' : 'Commencez à taper',
      message: q ? 'Aucune équipe, aucun joueur et aucune compétition ne correspond à « ' + q + ' ».' : 'Recherchez une équipe, un joueur ou une compétition.',
      icon: 'search'
    }) %>
  <% } else { %>
    <div class="flex flex-col gap-8">
      <% if (leagueResults.length) { %>
        <section>
          <%- include("partials/section-head", {
            title: 'Compétitions',
            meta: '<span class="ko-tabular text-[11px] text-mist-500">' + leagueResults.length + '</span>'
          }) %>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% leagueResults.forEach(function (lg) { %>
              <li>
                <a href="/leagues/<%= lg.id %>" class="ko-focus flex items-center gap-3 border border-line bg-ink-900 p-3 transition-colors duration-200 hover:border-line-strong hover:bg-ink-850">
                  <%- include("partials/logo", { id: lg.id, name: lg.name, kind: 'league', size: 'md' }) %>
                  <span class="min-w-0">
                    <span class="block truncate text-[13px] font-semibold text-mist-50"><%= lg.name %></span>
                    <span class="block truncate text-[11px] text-mist-500"><%= lg.country %><%= lg.isWomen ? ' · Féminin' : '' %></span>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (teamResults.length) { %>
        <section>
          <%- include("partials/section-head", {
            title: 'Équipes',
            meta: '<span class="ko-tabular text-[11px] text-mist-500">' + teamResults.length + '</span>'
          }) %>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% teamResults.forEach(function (tm) { %>
              <li>
                <a href="/teams/<%= tm.id %>" class="ko-focus flex items-center gap-3 border border-line bg-ink-900 p-3 transition-colors duration-200 hover:border-line-strong hover:bg-ink-850">
                  <%- include("partials/logo", { id: tm.id, name: tm.name, kind: 'team', size: 'md' }) %>
                  <span class="min-w-0">
                    <span class="block truncate text-[13px] font-semibold text-mist-50"><%= tm.name %></span>
                    <span class="block truncate text-[11px] text-mist-500"><%= tm.country || '' %><%= tm.countryCode ? ' · ' + tm.countryCode : '' %></span>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (playerResults.length) { %>
        <section>
          <%- include("partials/section-head", {
            title: 'Joueurs',
            meta: '<span class="ko-tabular text-[11px] text-mist-500">' + playerResults.length + '</span>'
          }) %>
          <ul class="border border-line bg-ink-900">
            <% playerResults.forEach(function (pl) { %>
              <li class="flex items-center gap-3 border-b border-line/80 px-3 py-2.5 last:border-b-0">
                <%- include("partials/logo", { id: pl.id, name: pl.name, kind: 'player', size: 'sm', round: true }) %>
                <a href="/players/<%= pl.id %>" class="min-w-0 flex-1">
                  <span class="block truncate text-[13px] font-medium text-mist-100 transition-colors duration-200 hover:text-acid-300"><%= pl.name %></span>
                  <span class="block truncate text-[11px] text-mist-500"><%= pl.currentTeamName || pl.nationality || '' %><%= pl.position ? ' · ' + pl.position : '' %></span>
                </a>
                <% if (pl.marketValueEur) { %>
                  <span class="ko-tabular shrink-0 text-[11px] text-mist-400"><%= fmt.eur(pl.marketValueEur) %></span>
                <% } %>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>
    </div>
  <% } %>
</div>
