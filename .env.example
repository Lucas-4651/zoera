# Port du serveur Express
PORT=3000

# Clé API Bzzoiro Sports Data (gratuite) : https://sports.bzzoiro.com/register/
# Sans cette clé, l'app démarre en MODE DÉMO (données simulées).
BSD_API_KEY=

# Base URL de l'API BSD
BSD_BASE_URL=https://sports.bzzoiro.com/api/v2

# Dossier du cache disque des réponses API (réduit la consommation du quota)
CACHE_DIR=./.cache
